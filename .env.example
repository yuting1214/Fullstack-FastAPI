# Application
ENV_MODE=dev          # dev | prod

# Authentication (for protecting /docs, /redoc)
# Leave empty to auto-generate — credentials are printed in the startup logs.
USER_NAME=
PASSWORD=

# Session secret key
# Leave empty to auto-generate on each start (sessions reset on restart);
# set a stable random string in production to keep sessions across deploys.
SECRET_KEY=

# Database (prod only — ignored in dev mode which uses SQLite)
DB_ENGINE=postgresql
DB_USERNAME=
DB_PASS=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=

# Alternative: single connection string (overrides individual DB_* vars above)
DATABASE_URL=

# Host URL (prod only)
HOST_URL=

# Server
PORT=5000
