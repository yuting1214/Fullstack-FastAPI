# Application
ENV_MODE=dev          # dev | prod

# Authentication (for protecting /docs, /redoc)
USER_NAME=
PASSWORD=

# Session secret key (generate a secure random string)
SECRET_KEY=

# Database (prod only — ignored in dev mode which uses SQLite)
DB_ENGINE=postgresql
DB_USERNAME=
DB_PASS=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=

# Alternative: single connection string (overrides individual DB_* vars above)
DATABASE_URL=

# Host URL (prod only)
HOST_URL=

# Server
PORT=5000
